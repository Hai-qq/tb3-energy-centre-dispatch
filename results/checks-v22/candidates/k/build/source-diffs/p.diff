+
+
+def test_lt_pump_outages(case):
+    day, plan, _ = case
+    for engine in day.engines:
+        for circuit in day.plant["heat_circuits"].values():
+            if f"{engine['id']} intercooler" in circuit["from"] and "pump" in circuit:
+                unavailable = ~day.available[circuit["pump"]]
+                assert (series(plan, "engines_kwe", engine["id"])[unavailable] <= 0.5).all()
